# Set this only on the backend. Paste the same value into the frontend's Demo token field.
DEMO_API_TOKEN=replace-with-a-long-random-token

# Frontend development origins; comma-separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: enables the story-premise -> scene-plan button in the frontend.
# Never paste this key into frontend code or commit it to GitHub.
ANTHROPIC_API_KEY=

# Optional; generation outputs are written here, outside source code.
STORYBOARD_OUTPUT_DIR=generated_outputs
LOG_LEVEL=INFO
# Keep 0 for GPU-first usage; only set 1 if you explicitly accept very slow CPU inference.
ALLOW_CPU_INFERENCE=0
